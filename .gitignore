# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Django
db.sqlite3
*.sqlite3
/staticfiles/
# Mídia: ignora conteúdo dinâmico, mas versiona as fotos curadas do site
# (galeria/quartos) — conteúdo estático que precisa ir para produção.
# (Railway = filesystem efêmero, sem S3; sem isto as fotos dão 404 no site.)
/media/*
!/media/galeria/
!/media/quartos/
local_settings.py

# Credenciais e segredos
credentials.json
oauth_client.json
.env
*.env

# Virtualenv
venv/
env/
.venv/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log

# Word lock files
~$*

# Documentos pessoais / rascunhos locais
Logo/*.pdf
TEMPORARIO/

# Graphify (grafo de conhecimento — regenerável com /graphify .)
graphify-out/

# Evidências Safrapay (JSON + prints — não versionar)
evidencias/safrapay/*.json
evidencias/safrapay/prints/*
!evidencias/safrapay/prints/.gitkeep
!evidencias/safrapay/README.md

# Artefatos grandes (não são código-fonte)
/SIteCRM*.zip
/SIteCRM_Vo_Testa_Design/

# Referência pesada — manter local, fora do git
docs/Foco_Tecnologia.pdf
